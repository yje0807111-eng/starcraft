.claude/
node_modules/
.vercel/
.DS_Store
Thumbs.db
*.log
# 던전 배경 작업용 원본(변환 후 .webp만 커밋)
assets/backgrounds/dungeons/*.png
assets/backgrounds/usemaps/*.png
assets/backgrounds/reb/*.png
assets/backgrounds/title/*.png
assets/backgrounds/dungeons/*.mp4
assets/backgrounds/dungeons/*.webm

# 배포 제외 — package.json 이 보이면 Vercel 이 정적 사이트 대신 빌드를 시도한다
/package.json
/package-lock.json

# 스프라이트 프레임 — 유닛이 확정되기 전에는 커밋하지 않는다.
# git 은 파일의 모든 버전을 영구 보관한다. 시안 단계마다 커밋하면 4만 장 규모에서
# 히스토리가 GB 단위로 불어난다(이미 재커밋된 바이너리로 팩이 1.9GB 다 — SPRITES.md §7).
# 확정된 유닛만 골라서:  git add -f assets/sprites/<종족>/<id>
assets/sprites/*/

# 세션 중 만든 검증용 렌더/프로브 산출물
scratch_*

# 🏢 건물 스프라이트 중간 산출물(원본 그림·크롭) — 게임이 읽지 않는다
_bld/

# 세션 중 만든 프로브 렌더(scratch_* 와 같은 것 — 이름만 다르다)
_*.png
_probe.mjs
_zoom.mjs

# 맵 업스케일 중간 산출물 — 조각 원본·AI 결과·붙인 것(합쳐 139MB)
#   ⚠ 결과물은 assets/backgrounds/ 에 들어간다. 여기는 다시 만들 수 있는 것뿐이다.
docs/mock/quarters/
docs/mock/visible/
